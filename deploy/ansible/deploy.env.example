# Copy to deploy.env (gitignored) on a machine that runs deployments.
#
# These are the same variables the deploy workflow feeds from repository secrets,
# so the inventory in this directory is one file, not two shapes of truth.
#
#   cp deploy.env.example deploy.env
#   chmod 600 deploy.env
#
# Do not commit the filled-in file: it names the node. The key stays where it
# already lives on the machine -- only its path goes here.

# Required: the deployment node.
CORMEX_DEPLOY_HOST=

# Defaults to `deploy`.
CORMEX_DEPLOY_USER=deploy

# Defaults to 22.
CORMEX_DEPLOY_PORT=22

# Path to the private key **on this machine**. On Windows (Git Bash) `~` works.
# The container path of `just deploy` mounts this file read-only when it is
# outside ~/.ssh.
CORMEX_DEPLOY_KEY=~/.ssh/id_ed25519

# Optional: a known_hosts file other than ~/.ssh/known_hosts. Host key checking
# stays on either way; pointing at the wrong file fails the connection instead of
# silently trusting a new key.
#CORMEX_DEPLOY_KNOWN_HOSTS=~/.ssh/known_hosts

# The deployment directory on the target: docker-compose.yml, .env, optional
# compose.override.yaml. Defaults to /srv/cormex/deploy.
CORMEX_DEPLOY_DIR=/srv/cormex/deploy

# Loopback base URL of the stack *on the target*; the playbook asks it what it is.
CORMEX_DEPLOY_API=http://127.0.0.1:8080

# Set to false when the images arrive as the release archives (docker load) instead
# of from a registry; the playbook then skips `compose pull`.
#CORMEX_DEPLOY_PULL=false

# Only for the local rehearsal (see docs/deployment-guide.md, section 9).
#CORMEX_DEPLOY_CONNECTION=local
#CORMEX_DEPLOY_PROJECT=cormex-rehearsal
