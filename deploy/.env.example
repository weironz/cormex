# Settings for the self-contained `docker-compose.yml` beside this file.
# Copy to `.env`, fill in the three credentials, then `docker compose up -d`.
#
# Our own production stack uses `docker-compose.prod.yml` and
# `.env.prod.example` instead. Those are a different shape -- domains, TLS,
# external volumes -- and mixing the two is what made this directory
# unrunnable for anyone but us.

# ── Version ───────────────────────────────────────────────
# Both images are tagged together. Pin it; a floating tag turns "which version
# is running" into a question nobody can settle.
CORMEX_VERSION=v0.1.11

# ── Credentials (no defaults -- compose refuses to start without them) ──
#
# The bootstrap token's hash. Generate the pair with:
#
#     docker run --rm willdockerhub/cormex:v0.1.11 --generate-token
#
# It prints the token once and the hash to paste here. The token itself is
# never stored anywhere -- losing it means generating a new pair. Keep only the
# hash on this machine; the token goes to whatever client connects.
CORMEX_AUTH_TOKEN_SHA256=

POSTGRES_PASSWORD=
RUSTFS_SECRET_KEY=

# ── Embeddings ────────────────────────────────────────────
# Vector search needs somewhere to vectorise. The default backend is `api`,
# which is one HTTP POST per batch -- it does not care whether the far end is
# hosted or the optional `embeddings` container in this file.
#
# ★ The model must be 1024-dimensional; the schema pins VECTOR(1024).
#
# Leaving these blank is allowed and the stack still starts -- but the failure
# then happens at the first vectorisation, not at startup. After `up`, read
# /health and check that `embedding.model` says `api:<your model>`.
CORMEX_EMBED_BACKEND=api
CORMEX_EMBED_ENDPOINT=
CORMEX_EMBED_MODEL=
CORMEX_EMBED_API_KEY=

# To run the embedding model locally instead, uncomment these. It wants ~3 GB
# of RAM on its own -- see the `embeddings` service for why it is off by default.
#COMPOSE_PROFILES=embed
#CORMEX_EMBED_ENDPOINT=http://embeddings/v1/embeddings
#CORMEX_EMBED_MODEL=bge-m3

# ── Extraction (optional) ─────────────────────────────────
# Turning conversations into facts is an LLM job. Without a key the service
# still runs, stores, and retrieves -- it just never extracts anything new.
CORMEX_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# ── Where it listens ──────────────────────────────────────
# Loopback by default: nothing here terminates TLS, so the host is the
# boundary. Put a real proxy in front before changing the bind address.
#CORMEX_BIND_ADDR=127.0.0.1
#CORMEX_PORT=8080
#CORMEX_S3_PORT=9000

# Set both if you reach this from anywhere but localhost. The first is the
# origin allowed to talk to the object store from a browser; the second is the
# blob address handed to that browser. Getting them wrong shows up as images
# that never load, with a CORS error in the console.
#CORMEX_PUBLIC_URL=http://your-host:8080
#CORMEX_S3_PUBLIC_URL=http://your-host:9000

# ── Pulling from somewhere else ───────────────────────────
#CORMEX_REGISTRY=willdockerhub
#CORMEX_IMAGE=
#CORMEX_WEB_IMAGE=
