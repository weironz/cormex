# Settings for `docker-compose.prod.yml` -- OUR production stack.
#
# Deploying Cormex yourself? You want `.env.example` and the
# self-contained `docker-compose.yml` instead. This one assumes an edge
# proxy terminating TLS for three hostnames, and volumes that already
# exist under names only our node has.
#
# Every variable below is REQUIRED -- compose refuses to start without it rather
# than substituting an empty string. That is deliberate: an empty DOMAIN yields a
# traefik rule of `Host()`, which matches nothing and produces a 404 that looks
# like a DNS problem.

# ── Hostnames ─────────────────────────────────────────────
# The memory browser, and the API under its /api prefix. Same origin on purpose:
# with one hostname for both, the server needs no CORS configuration at all.
CORMEX_DOMAIN=cormex.example.com

# The hostname some OTHER application reaches the API on, also under /api. If you
# only run Cormex, set this to the same value as CORMEX_DOMAIN.
DOMAIN=cormex.example.com

# The S3-compatible object store (RustFS). Blobs are served from here.
# ★ 必须是**这个栈自己的**一个子域，不能借用另一个 compose 项目的 S3 域名：
#   浏览器取 blob 走预签名 URL，签名里带 host；两个容器抢同一条 traefik 规则时
#   请求会被轮询到两个存储上。
S3_DOMAIN=s3.example.com

# 本栈 rustfs 里的桶名；空则用 docker-compose.prod.yml 的默认 cormex-blobs。
#S3_BUCKET=cormex-blobs

# ── Version ───────────────────────────────────────────────
# Both images are tagged together. Pin it; never use a floating tag, or "which
# version is in production" becomes a question nobody can answer.
CORMEX_VERSION=v0.1.11

# ── Credentials ───────────────────────────────────────────
# The bootstrap token's hash. Generate with `cormexd --generate-token`, which
# prints the token once and the hash to put here. The token itself is never
# stored -- losing it means generating a new pair.
CORMEX_AUTH_TOKEN_SHA256=

POSTGRES_PASSWORD=
RUSTFS_SECRET_KEY=

# ── Optional ──────────────────────────────────────────────
# Pull from somewhere other than the default registry, or override a single
# image (useful when rolling one service forward without the other).
#CORMEX_REGISTRY=registry.cn-shenzhen.aliyuncs.com/willspace
#CORMEX_IMAGE=
#CORMEX_WEB_IMAGE=
