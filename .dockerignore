# Admit only inputs used by the source-build Dockerfiles. New top-level
# files stay out of the context until deliberately added here.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!LICENSE
!NOTICE
!crates/
!crates/**
!evals/
!evals/**
!migrations/
!migrations/**
!migrations-global/
!migrations-global/**
!app/
app/*
!app/pubspec.yaml
!app/pubspec.lock
!app/.metadata
!app/lib/
!app/lib/**
!app/web/
!app/web/**
!app/assets/
!app/assets/**
!scripts/
scripts/*
!scripts/docker/
scripts/docker/*
!scripts/docker/nginx.conf

# Keep these excluded even beneath an admitted source directory.
**/.git
**/.env*
**/*.env
**/*.local.md
**/*.pem
**/*.key
**/credentials.json
**/.aws
**/.ssh
**/.codex
**/.claude
**/.cormex
**/.playwright-mcp
**/.dart_tool
**/.idea
**/.vscode
**/target
**/build
**/dist
**/node_modules
**/ephemeral
**/data
**/logs
**/screenshots
**/tests/fixtures
**/*screenshot*.png
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# The prebuilt Web Dockerfile admits its release bundle through an explicit
# named context; host build output stays out of this source-build context.
app/build
app/.dart_tool
deploy/*.local.md
